# Northstar env (copy to .env — gitignored)

NORTHSTAR_HOST=127.0.0.1
NORTHSTAR_HTTP_PORT=8080
NORTHSTAR_PORT=8443
NORTHSTAR_ROLE=shore
NORTHSTAR_CHALLENGE_REQUIRED=true
NORTHSTAR_OSNMA_SCOPE=fullstack
# NORTHSTAR_AUDIT_MIRROR_PATH=/tmp/northstar-audit.checkpoint.json

NORTHSTAR_KEY_DIR=.northstar/keys
NORTHSTAR_SHORE_KEY_DIR=.northstar/shore

# Optional TLS / mTLS (device plane on :8443; web stays :8080)
# NORTHSTAR_TLS_ENABLED=true
# NORTHSTAR_MTLS_ENABLED=true
# NORTHSTAR_CERT_DIR=certs
# NORTHSTAR_DEVICE_MTLS=true
# NORTHSTAR_TELEMETRY_URL=https://127.0.0.1:8443/api/telemetry

# PKCS#11 / SoftHSM (see scripts/setup-softhsm.sh and HARDWARE_KEYS.md)
# NORTHSTAR_SIGNER_BACKEND=pkcs11
# SOFTHSM2_CONF=.northstar/softhsm/softhsm2.conf
# NORTHSTAR_PKCS11_MODULE=/opt/homebrew/lib/softhsm/libsofthsm2.so
# NORTHSTAR_PKCS11_PIN=1234
# NORTHSTAR_PKCS11_KEY_LABEL=northstar-device
# NORTHSTAR_PKCS11_PUBKEY=.northstar/softhsm/device.p256.pub.b64

# OSNMA_SIDECAR_ENABLED=true
# OSNMA_SIDECAR_URL=http://127.0.0.1:8791
# AISSTREAM_API_KEY=

# —— Improvement plan (v2) ——
# Config selection (default v2; v1 kept selectable). Values: v1 | v2 | <path to json>
# NORTHSTAR_THRESHOLDS=v2
# NORTHSTAR_FUSION=v2
# Runtime data dir for audit log, device registry, revocation list, replay guard,
# OSNMA cache, enrolment token and new recordings (seeded from data/ on first run).
# NORTHSTAR_DATA_DIR=.northstar/data
# NORTHSTAR_LEGACY_DATA_PATHS=true        # write back into data/fixtures like before
# Hist Lab: legacy per-vessel looping playheads instead of one shared replay clock
# NORTHSTAR_LAB_LEGACY_PLAYHEAD=true
# NORTHSTAR_LAB_DRIFT_MPS=1               # gradual_drift overlay speed in shared mode
# Replay file the Lab reads (default: runtime copy; tests use the frozen snapshot)
# NORTHSTAR_REPLAY_PATH=data/replay/snapshots/gof_ais.eval-v1.jsonl
# Device enrolment token (generated on first run; device-sim reads it)
# NORTHSTAR_ENROL_TOKEN_PATH=.northstar/data/enrol.token
# NORTHSTAR_DEVICE_LEGACY_CLOCK=true      # device-sim wall-clock playhead (pre-P3.2)

# Admin routes (scenarios, RF load, OSNMA verify, audit re-anchor). If unset, the demo token
# "northstar-demo-admin" works only while NORTHSTAR_HOST is loopback; on any other address the
# server refuses to start unless NORTHSTAR_ALLOW_DEMO_ADMIN=true. The web UI sends
# VITE_NORTHSTAR_ADMIN_TOKEN.
NORTHSTAR_ADMIN_TOKEN=
# NORTHSTAR_ALLOW_DEMO_ADMIN=false
# Optional: require ?token= on /ws (web UI sends VITE_NORTHSTAR_WS_TOKEN).
NORTHSTAR_WS_TOKEN=
